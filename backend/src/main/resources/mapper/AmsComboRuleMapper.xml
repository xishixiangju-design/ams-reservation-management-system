<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.trae.ams.mapper.AmsComboRuleMapper">

    <resultMap id="BaseResultMap" type="com.trae.ams.entity.AmsComboRule">
        <id column="id" property="id" />
        <result column="store_id" property="storeId" />
        <result column="name" property="name" />
        <result column="condition_json" property="conditionJson" />
        <result column="discount_type" property="discountType" />
        <result column="discount_value" property="discountValue" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <select id="selectActiveRules" resultMap="BaseResultMap">
        SELECT *
        FROM ams_combo_rule
        WHERE (store_id = #{storeId} OR store_id IS NULL)
          AND status = 1
    </select>

</mapper>
